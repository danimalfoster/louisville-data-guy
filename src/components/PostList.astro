---
import type { CollectionEntry } from 'astro:content';
import { chipName, getTerms } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
const minutes = (body = '') => Math.max(1, Math.round(body.split(/\s+/).length / 230));
const termName = new Map((await getTerms()).map((t) => [t.id, chipName(t.data.term)]));
---

<ul class="post-list">
	{
		posts.map((post) => {
			const tags = (post.data.terms ?? []).filter((t) => termName.has(t.id)).slice(0, 4);
			return (
				<li class="card">
					<p class="post-meta">
						{post.data.deepDive && <span class="kind-tag">Deep dive</span>}
						<FormattedDate date={post.data.pubDate} /> · {minutes(post.body)} min read
						{post.data.draft && <span class="draft-tag">draft</span>}
					</p>
					<h3 class="post-title">
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					</h3>
					<p class="post-desc">{post.data.description}</p>
					<div class="card-foot">
						{tags.length > 0 && (
							<ul class="chips" aria-label="Topics">
								{tags.map((t) => (
									<li>
										<a class="chip" href={`/glossary/${t.id}/`}>
											{termName.get(t.id)}
										</a>
									</li>
								))}
							</ul>
						)}
						<a class="read-more" href={`/blog/${post.id}/`} aria-hidden="true" tabindex="-1">
							Read more →
						</a>
					</div>
				</li>
			);
		})
	}
</ul>
<style>
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1em;
	}
	.card {
		position: relative;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.2em 1.4em 1.1em;
		box-shadow: var(--shadow);
		transition:
			transform 0.15s ease,
			border-color 0.15s ease;
	}
	.card:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
	}
	.post-title {
		margin: 0.15em 0 0.3em;
		font-size: 1.45em;
		line-height: 1.2;
	}
	.post-title a {
		color: var(--heading);
		text-decoration: none;
	}
	.post-title a:hover {
		color: var(--accent);
	}
	.post-desc {
		margin: 0 0 0.8em;
		color: var(--text);
		font-size: 0.95em;
	}
	.post-meta {
		margin: 0;
		color: var(--muted);
		font-size: 0.8em;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8em;
		flex-wrap: wrap;
	}
	.read-more {
		font-size: 0.9em;
		font-weight: 600;
		text-decoration: none;
		margin-left: auto;
	}
	.kind-tag {
		margin-right: 0.6em;
		padding: 0.1em 0.5em;
		border-radius: 4px;
		background: var(--chip-bg);
		color: var(--chip-text);
		font-weight: 600;
		font-size: 0.85em;
	}
	.draft-tag {
		margin-left: 0.5em;
		padding: 0.1em 0.5em;
		border-radius: 4px;
		background: var(--draft-bg);
		color: var(--draft-text);
		font-size: 0.85em;
		letter-spacing: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
		.card:hover {
			transform: none;
		}
	}
</style>
