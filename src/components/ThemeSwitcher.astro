---
// Preview-only control for comparing design options. Never rendered on the live site.
const options = [
	{ id: 'a', label: 'A · Bourbon' },
	{ id: 'b', label: 'B · River City' },
	{ id: 'c', label: 'C · Bluegrass' },
	{ id: 'd', label: 'D · Notebook' },
];
---

<div class="theme-switcher" role="group" aria-label="Preview design options">
	<span>Design preview:</span>
	{options.map((o) => <button type="button" data-set-theme={o.id}>{o.label}</button>)}
</div>
<script is:inline>
	(function () {
		var root = document.documentElement;
		function mark() {
			var cur = root.dataset.theme || 'b';
			document.querySelectorAll('[data-set-theme]').forEach(function (b) {
				b.setAttribute('aria-pressed', String(b.dataset.setTheme === cur));
			});
		}
		document.querySelectorAll('[data-set-theme]').forEach(function (b) {
			b.addEventListener('click', function () {
				root.dataset.theme = b.dataset.setTheme;
				try {
					localStorage.setItem('ldg-theme', b.dataset.setTheme);
				} catch (e) {}
				mark();
			});
		});
		mark();
	})();
</script>
<style>
	.theme-switcher {
		position: fixed;
		left: 50%;
		bottom: 16px;
		transform: translateX(-50%);
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 6px;
		max-width: calc(100% - 32px);
		padding: 8px 12px;
		background: #111827;
		color: #f9fafb;
		border-radius: 12px;
		font: 14px/1.2 system-ui, sans-serif;
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
		z-index: 100;
	}
	.theme-switcher button {
		font: inherit;
		color: #f9fafb;
		background: transparent;
		border: 1px solid #4b5563;
		border-radius: 8px;
		padding: 6px 10px;
		cursor: pointer;
	}
	.theme-switcher button[aria-pressed='true'] {
		background: #f9fafb;
		color: #111827;
		border-color: #f9fafb;
	}
</style>
