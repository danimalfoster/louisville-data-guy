---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="brand">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/glossary">Glossary</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/search" class="icon-btn" aria-label="Search" title="Search">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
					<path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
				</svg>
			</a>
			<button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch to dark mode" title="Switch theme">
				<svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
				</svg>
				<svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
					<path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>
<script is:inline>
	(() => {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		const root = document.documentElement;
		const isDark = () =>
			root.dataset.theme === 'dark' ||
			(!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
		const label = () => btn.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
		label();
		btn.addEventListener('click', () => {
			const next = isDark() ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch (e) {}
			label();
			document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
		});
	})();
</script>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		width: 700px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 0 1em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0 0.5em;
	}
	.brand {
		font-family: var(--font-head);
		font-weight: var(--head-weight);
		font-size: 1.15em;
		text-transform: var(--brand-case);
		color: var(--brand-color);
		text-decoration: none;
		padding: 0.9em 0;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.1em;
	}
	nav :global(.internal-links a) {
		color: var(--text);
		text-decoration: none;
		padding: 1em 0;
		border-bottom: 3px solid transparent;
	}
	nav :global(.internal-links a.active) {
		border-bottom-color: var(--accent);
		font-weight: inherit;
		text-decoration: none;
	}
	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: 0;
		color: var(--muted);
		cursor: pointer;
		padding: 0.4em !important;
		border-radius: 6px;
		border-bottom: 0 !important;
	}
	.icon-btn:hover {
		color: var(--accent);
		background: var(--surface);
	}
	.sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .sun {
		display: block;
	}
	:global(:root[data-theme='dark']) .moon {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .sun {
			display: block;
		}
		:global(:root:not([data-theme='light'])) .moon {
			display: none;
		}
	}
	@media (max-width: 480px) {
		.internal-links {
			gap: 0.7em;
		}
	}
</style>
