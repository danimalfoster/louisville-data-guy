---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { chipName, getTerms } from '../utils/posts';

// pubDate is optional so standalone pages (like About) can use this layout without a date.
type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate' | 'draft'> & {
	pubDate?: Date;
	draft?: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, draft, terms = [] } = Astro.props;
const allTerms = await getTerms();
const tags = terms
	.map((r) => allTerms.find((t) => t.id === r.id))
	.filter((t) => t !== undefined);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				{heroImage && <Image width={1020} height={510} src={heroImage} alt="" class="hero" />}
				<header class="post-head">
					<h1>{title}</h1>
					{
						pubDate && (
							<p class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span>
										{' '}
										· Updated <FormattedDate date={updatedDate} />
									</span>
								)}
							</p>
						)
					}
					{
						tags.length > 0 && (
							<ul class="chips tags" aria-label="Topics">
								{tags.map((t) => (
									<li>
										<a class="chip" href={`/glossary/${t.id}/`} title={t.data.short}>
											{chipName(t.data.term)}
										</a>
									</li>
								))}
							</ul>
						)
					}
					{draft && <p class="draft-banner">DRAFT: not visible on the live site</p>}
				</header>
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	.post-head {
		margin-bottom: 2em;
		padding-bottom: 1em;
		border-bottom: 1px solid var(--border);
	}
	.date {
		color: var(--muted);
		margin: 0;
	}
	.tags {
		margin-top: 0.8em;
	}
	.hero {
		margin-bottom: 1.5em;
	}
	.draft-banner {
		background: var(--draft-bg);
		color: var(--draft-text);
		padding: 0.5em 1em;
		border-radius: 4px;
		font-weight: 700;
		margin-top: 1em;
	}
</style>
